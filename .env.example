# Configuración del Entorno de traductor-gemini

# Google Gemini API Key (Opcional si se usa fallback a deep-translator)
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo de Gemini por defecto
GEMINI_MODEL=gemini-2.5-flash

# Configuración del Servidor API
HOST=0.0.0.0
PORT=8000
DEBUG=false
APP_ENV=development

# Configuración de Caché y Base de Datos
CACHE_TTL_SECONDS=86400
DATABASE_URL=sqlite+aiosqlite:///./data/traductor.db

# CORS Origins (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:8000
